// Place your settings in this file to overwrite default and user settings.
{
	"files.insertFinalNewline": true,
	"files.exclude": {
		"out": false, // set this to true to hide the "out" folder with the compiled JS files
		"dist": false // set this to true to hide the "dist" folder with the compiled JS files
	},
	"search.exclude": {
		"out": true, // set this to false to include "out" folder in search results
		"dist": true, // set this to false to include "dist" folder in search results,
		"node_modules": true,
		"dist-standalone": true
	},
	// Generated proto output is gitignored; force the file watcher to see it so
	// the TypeScript language service picks up `bun run protos` without a restart.
	"files.watcherInclude": [
		"${workspaceFolder}/apps/vscode/src/shared/proto",
		"${workspaceFolder}/apps/vscode/src/generated",
		"${workspaceFolder}/apps/vscode/webview-ui/src/services/grpc-client.ts"
	],
	// Turn off tsc task auto detection since we have the necessary tasks as npm scripts
	"typescript.tsc.autoDetect": "off",
	"typescript.preferences.quoteStyle": "double",
	"typescript.tsdk": "node_modules/typescript/lib",
	"cSpell.words": [
		"orvanta",
		"Orvanta",
		"frontmatter",
		"keymap",
		"Worktrees",
		"Dedup",
		"dedup",
		"khóa",
		"gitcheck",
		"Flexbox",
		"cursorrules",
		"tabler",
		"Tabler",
		"scroller",
		"Scroller",
		"msvc",
		"evals",
		"cutover",
		"Cutover",
		"Favorited",
		"ENOSPC"
	],
	// Protobuf settings
	"protoc": {
		"options": [
			"--proto_path=apps/vscode/proto"
		]
	},
	// Enable Lint and format using Biome
	"biome.enabled": true,
	"biome.requireConfiguration": true,
	"prettier.enable": false,
	"editor.defaultFormatter": "biomejs.biome",
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "explicit",
		"source.removeUnused.biome": "always",
		"source.organizeImports.biome": "always"
	},
	// Disable auto-forwarding ports to prevent Simple Browser from opening the Vite dev server
	"remote.autoForwardPorts": false,
	"terminal.integrated.env.windows": {
		"PATH": "${env:USERPROFILE}\\.bun\\bin;${env:PATH}"
	}
}
